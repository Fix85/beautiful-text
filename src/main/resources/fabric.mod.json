{
  "schemaVersion": 1,
  "id": "beautiful-text",
  "version": "${version}",
  "name": "Beautiful Text",
  "description": "Automatic chat formatting: prefix every Minecraft chat message with custom color/format codes.",
  "authors": [
    "Fix85"
  ],
  "contact": {
    "homepage": "https://github.com/Fix85/beautiful-text",
    "sources": "https://github.com/Fix85/beautiful-text",
    "issues": "https://github.com/Fix85/beautiful-text/issues"
  },
  "environment": "client",
  "icon": "assets/beautiful-text/icon.png",
  "entrypoints": {
    "client": [
      "dev.fix85.BeautifulTextClient"
    ],
    "modmenu": [
      "dev.fix85.BeautifulTextModMenu"
    ]
  },
  "mixins": [
    "beautiful-text.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.21.8",
    "java": ">=21"
